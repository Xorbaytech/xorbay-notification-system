PORT=3000
PUBLISHER_API_KEY=local-development-key
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/communication_notification?schema=public"
POSTGRES_DB=communication_notification
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── ERP integration (channel callback adapters) ─────────────────────────────
# Where the ERP backend listens for IN_APP / WHATSAPP delivery callbacks.
ERP_API_URL=http://localhost:3001
# Shared secret for the platform -> ERP recipient-resolution callback.
# Falls back to ERP_CALLBACK_SECRET for local compatibility.
ERP_RECIPIENT_RESOLVER_SECRET=local-dev-callback-secret
# Shared secret; must match ERP_CALLBACK_SECRET on the ERP side.
ERP_CALLBACK_SECRET=local-dev-callback-secret
# Optional per-provider overrides (recommended in production).
# CALLBACK_SECRET_ERP_IN_APP=
# CALLBACK_SECRET_ERP_WHATSAPP=
# CALLBACK_SECRET_SMTP=
# Callback HTTP timeout in ms.
ERP_CALLBACK_TIMEOUT_MS=10000
# Shared provider callback gate. All IN_APP/WHATSAPP workers consume this one
# budget before calling ERP, preventing per-queue bursts from causing 429s.
# The default 75 requests/second is below the ERP callback ceiling of 6,000/min.
ERP_CALLBACK_RATE_LIMIT_ENABLED=true
ERP_CALLBACK_RATE_LIMIT_MAX=75
ERP_CALLBACK_RATE_LIMIT_WINDOW_MS=1000
ERP_CALLBACK_RATE_LIMIT_CRITICAL_RESERVE=15
ERP_CALLBACK_RATE_LIMIT_ACQUIRE_TIMEOUT_MS=15000
ERP_CALLBACK_RATE_LIMIT_RETRY_DELAY_MS=2000
# Resolver gate shared by all notification instances through Redis. 75 req/s
# stays below the ERP resolver's 6,000 req/min ceiling while smoothing bursts.
# ERP_RESOLVER_RATE_LIMIT_ENABLED=true
# ERP_RESOLVER_RATE_LIMIT_MAX=75
# ERP_RESOLVER_RATE_LIMIT_WINDOW_MS=1000
# ERP_RESOLVER_RATE_LIMIT_ACQUIRE_TIMEOUT_MS=30000
# Durable source-event retry backoff (the first retry is about 5s, then doubles
# until the configured cap; jitter prevents synchronized retry waves).
# OUTBOX_RETRY_BASE_MS=5000
# OUTBOX_RETRY_MAX_MS=300000

# ── SMTP (EMAIL channel) ─────────────────────────────────────────────────────
# When unset in non-production, an Ethereal test account is used automatically.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=
#SMTP_PASS=

# ── Redis (BullMQ) ───────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# Prefer REDIS_URL for deployed environments so credentials and TLS are configured
# atomically (for example: rediss://user:password@redis.example.com:6380/0).
#REDIS_URL=
#REDIS_USERNAME=
#REDIS_PASSWORD=
#REDIS_TLS=false
# Maximum publications submitted by the outbox relay during one scheduler tick.
OUTBOX_RELAY_MAX_PER_TICK=500
# Publications claimed and sent with one BullMQ addBulk operation per queue.
# Set both relay values to 1 for an immediate, safe single-row rollback.
OUTBOX_RELAY_BATCH_SIZE=500
# Delivery retry policy (values are clamped to safe operational ranges).
DELIVERY_QUEUE_ATTEMPTS=3
DELIVERY_QUEUE_BACKOFF_MS=5000
# Number of BullMQ delivery jobs processed concurrently by this instance.
DELIVERY_WORKER_CONCURRENCY=1
CRITICAL_WORKER_CONCURRENCY=2
BULK_WORKER_CONCURRENCY=2
# Redis-backed per-queue pacing. Defaults aggregate to 90 callbacks/second,
# below the ERP callback ceiling of 6,000 requests/minute. Tune only after
# measuring provider capacity; values are jobs per duration window.
# DELIVERY_WORKER_RATE_LIMIT=20
# DELIVERY_WORKER_RATE_LIMIT_DURATION_MS=1000
# CRITICAL_WORKER_RATE_LIMIT=50
# CRITICAL_WORKER_RATE_LIMIT_DURATION_MS=1000
# BULK_WORKER_RATE_LIMIT=20
# BULK_WORKER_RATE_LIMIT_DURATION_MS=1000
PUBLISHER_CRITICAL_MODULES=erp-core
# Broadcast fan-out controls.
BROADCAST_BATCH_SIZE=500
BROADCAST_MAX_RECIPIENTS=10000
# PostgreSQL transaction wait/timeout controls.
PRISMA_TX_MAX_WAIT_MS=10000
PRISMA_TX_TIMEOUT_MS=30000
# How long a queue publication may remain SUBMITTING before a crashed relay
# is safely reclaimed.  The stable job key makes reclamation idempotent.
QUEUE_PUBLICATION_LEASE_TIMEOUT_MS=60000
# A delivery left PROCESSING beyond this lease is reconciled by the recovery
# cron and re-entered through the durable retry/outbox path. Keep this longer
# than the normal provider HTTP timeout.
DELIVERY_PROCESSING_TIMEOUT_MS=120000
# Maximum stale deliveries reconciled in one cron tick.
DELIVERY_RECOVERY_BATCH_SIZE=100

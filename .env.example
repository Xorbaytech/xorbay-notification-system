# ==============================================================================
# Notification Platform Microservice — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values for your environment (local or cloud).
# In production (e.g. Vercel, Railway, Render), set these in your hosting platform dashboard.

# ── 1. Server Configuration ──────────────────────────────────────────────────
# The HTTP port for the NestJS API server (ignored on Vercel serverless).
PORT=3002

# ── 2. Database (PostgreSQL / Neon) ──────────────────────────────────────────
# Required. Connection string for Prisma ORM.
# Local development format:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/notification_db?schema=public"
#
# Cloud Neon PostgreSQL format (Pooler recommended for serverless):
DATABASE_URL="postgresql://<user>:<password>@<neon-pooler-host>/<database>?sslmode=require&channel_binding=require"

# Optional: used only if running local postgres via docker-compose.yml
POSTGRES_DB=notification_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── 3. Security & API Authentication ─────────────────────────────────────────
# Required. Shared secret key expected in the HTTP header from upstream publishers
# (e.g. ERP backend) to authenticate event publishing requests.
PUBLISHER_API_KEY=local-development-key

# ── 4. Redis Infrastructure (BullMQ Queues) ──────────────────────────────────
# Required for BullMQ job queues (delivery, critical-delivery, bulk-delivery).
#
# Option A: Local Redis (default for development)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false

# Option B: Cloud Redis (Preferred for production / Vercel / Railway / Upstash)
# Setting REDIS_URL overrides REDIS_HOST and REDIS_PORT automatically:
# REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# ── 5. ERP Integration & Delivery Callbacks ──────────────────────────────────
# Base URL where the ERP backend listens for IN_APP and WHATSAPP channel callbacks.
ERP_API_URL=http://localhost:3001

# Shared secret to authenticate callbacks sent from this microservice to the ERP.
# Must match the callback secret configured on the ERP service side.
ERP_CALLBACK_SECRET=local-dev-callback-secret

# Shared secret for recipient resolution callbacks (defaults to ERP_CALLBACK_SECRET).
ERP_RECIPIENT_RESOLVER_SECRET=local-dev-callback-secret

# Callback HTTP request timeout in milliseconds.
ERP_CALLBACK_TIMEOUT_MS=10000

# Rate limiting gate for ERP callbacks to prevent overwhelming downstream services (429s).
ERP_CALLBACK_RATE_LIMIT_ENABLED=true
ERP_CALLBACK_RATE_LIMIT_MAX=75
ERP_CALLBACK_RATE_LIMIT_WINDOW_MS=1000
ERP_CALLBACK_RATE_LIMIT_CRITICAL_RESERVE=15
ERP_CALLBACK_RATE_LIMIT_ACQUIRE_TIMEOUT_MS=15000
ERP_CALLBACK_RATE_LIMIT_RETRY_DELAY_MS=2000

# ── 6. Email Provider (SMTP) ─────────────────────────────────────────────────
# If unset in non-production, an Ethereal test account is automatically created.
# In production, provide credentials for your SMTP provider (SendGrid, SES, Resend, etc.):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-smtp-api-key

# ── 7. BullMQ Worker Concurrency & Tuning ───────────────────────────────────
# Number of simultaneous jobs processed by this instance per queue.
DELIVERY_WORKER_CONCURRENCY=4
CRITICAL_WORKER_CONCURRENCY=2
BULK_WORKER_CONCURRENCY=2

# Maximum publications submitted by the outbox relay cron per scheduler tick.
OUTBOX_RELAY_MAX_PER_TICK=500
OUTBOX_RELAY_BATCH_SIZE=500

# Delivery retry policy
DELIVERY_QUEUE_ATTEMPTS=3
DELIVERY_QUEUE_BACKOFF_MS=5000

# Lease timeout (ms) before a stuck queue submission or delivery is reclaimed.
QUEUE_PUBLICATION_LEASE_TIMEOUT_MS=60000
DELIVERY_PROCESSING_TIMEOUT_MS=120000
DELIVERY_RECOVERY_BATCH_SIZE=100

# PostgreSQL transaction timeouts (ms)
PRISMA_TX_MAX_WAIT_MS=10000
PRISMA_TX_TIMEOUT_MS=30000
